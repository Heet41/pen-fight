# ═══════════════════════════════════════════════════════════════════════════════
# PEN FIGHT — PRODUCTION & DEVELOPMENT ENVIRONMENT TEMPLATE
# Copy to `.env` for local development or set in your cloud hosting provider
# (Render / Railway / Vercel / Fly.io / AWS / Docker)
# ═══════════════════════════════════════════════════════════════════════════════

# ─── DATABASE (PostgreSQL) ───────────────────────────────────────────────────
# Connection string with credentials and pool parameters
# Example (Local): postgresql://username:password@localhost:5432/penfight?schema=public
# Example (Neon/Supabase/Render): postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@localhost:5432/penfight?schema=public"

# ─── SERVER CONFIGURATION ────────────────────────────────────────────────────
# Port provided automatically by cloud platforms (Render/Railway sets PORT dynamically)
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# ─── AUTHENTICATION & SECURITY SECRETS ───────────────────────────────────────
# Generate a strong 32+ character random string (e.g. `openssl rand -base64 32`)
JWT_SECRET=your-32-character-jwt-secret-here
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your-32-character-cookie-secret-here

# ─── CORS & ORIGINS ──────────────────────────────────────────────────────────
# Single URL or comma-separated list of allowed frontend domains
# Example: https://penfight.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ─── RATE LIMITING ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX=20

# ─── FRONTEND (Vite) ENVIRONMENT VARIABLES ───────────────────────────────────
# If deploying frontend separately (e.g. Vercel / Cloudflare Pages / Netlify),
# set these in your frontend project dashboard:
# VITE_API_URL=https://your-penfight-backend.onrender.com
# VITE_SOCKET_URL=https://your-penfight-backend.onrender.com
